# Optional model-backed natural-language routing and assistant classification.
# Copy this file to .env and provide a key for your OpenAI-compatible provider.
# Without these settings, the assistant remains fully usable in deterministic local mode.
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_API_TIMEOUT=12

# Optional natural-language assistant model (OpenAI-compatible chat completions)
# Copy .env.example to .env and fill these values. Local academic database tools
# remain authoritative; the model may phrase answers only from retrieved records.
AI_ASSISTANT_LLM=auto
AI_ASSISTANT_BASE_URL=https://api.openai.com/v1
AI_ASSISTANT_API_KEY=
AI_ASSISTANT_MODEL=
